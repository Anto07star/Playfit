# ---- Server ----
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- PostgreSQL (local, port 5432) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=playfit

# ---- Admin account (created automatically on first start) ----
ADMIN_EMAIL=admin@playfit.in
ADMIN_PASSWORD=Admin@123
JWT_SECRET=change-this-to-a-long-random-string

# ---- Shop settings ----
SHIPPING_FEE=0
CUSTOM_FEE=150

# ---- Razorpay (leave empty to disable online payment; COD still works) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- For hosting (leave empty locally) ----
# One connection string from Neon/Supabase. When set, DB_HOST/DB_USER/... above are ignored.
DATABASE_URL=
# Optional free image hosting so admin uploads survive on free servers (cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
